---
// Layout.astro
interface Props {
  title: string;
}
import '@fontsource-variable/league-spartan';
import NavBar from '../components/NavBar.astro';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es-EC">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Spondylus Mora Travel - Alquiler de lanchas y yates en Manta, Ecuador" />
    <title>{title}</title>
    <link rel="icon" href="/svg/favicon.svg" type="image/svg+xml"/> 
  </head>
  <body>
    <NavBar />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }

  html {
    font-family: 'League Spartan Variable', system-ui, sans-serif;
  }

  body {
    background: #EEF5FF;
    color: #202020;
  }
</style>
