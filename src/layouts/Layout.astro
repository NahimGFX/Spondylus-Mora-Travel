---
// Layout.astro
interface Props {
  title: string;
}
import '@fontsource-variable/league-spartan';
import NavBar from './NavBar.astro';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es-EC">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <NavBar />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }

  html {
    font-family: 'League Spartan Variable', system-ui, sans-serif;
  }

  body {
    background: #fbfeff;
    color: #202020;
  }
</style>
