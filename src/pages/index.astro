---
import Card from '../components/Card.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title={"Spondylus - Mora Travel"}>
	<main>
		<section class="relative w-full h-[calc(100vh-80px)] px-4 text-center section-bg flex items-center justify-center">
			<div class="text-[#EEF5FF] drop-shadow-md space-y-6 animate-in fade-in slide-in-from-bottom duration-700">
				<h1 class="text-5xl md:text-6xl lg:text-7xl font-bold">
					Spondylus Mora Travel
				</h1>
				<p class="text-2xl leading-tight max-w-prose mx-auto">
					Descubre la magia de Manta a bordo de nuestras lanchas y yates. Vive el turismo desde el mar con Spondylus Mora Travel: aventura, confort y paisajes inolvidables.
				</p>
					<a href="/contacts" class="mt-6 block">
						<button class="bg-[#B4D4FF] text-[#176B87] text-3xl font-semibold px-7 py-7 rounded-lg shadow hover:bg-[#86B6F6] transition duration-300">
							Reservar Ahora
						</button>
					</a>
			</div>
		</section>
		<div class="mt-6 animate-in fade-in slide-in-from-bottom duration-700">
			<i class='animate-bounce bxr  bx-chevrons-down text-5xl text-[#176B87] flex justify-center'></i>
		</div>
		<section class="flex justify-center">
			<Card
			title={"Yate"}
			description = {"LjaklsdaskldmnxcnlKQDJKLASNZJXNCSAKJCN ALKJSD AKSLDN ASK KDLAS NZLXKCJ KQLWDNAJKL SDNKL"}
			href = {"/about"}
			/>
			<Card
			title={"Yate"}
			description = {"LjaklsdaskldmnxcnlKQDJKLASNZJXNCSAKJCN ALKJSD AKSLDN ASK KDLAS NZLXKCJ KQLWDNAJKL SDNKL"}
			href = {"/about"}
			/>
		</section>
	</main>
</Layout>

<style>
.section-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: url('/img/background.png');
  background-size: cover;
  background-position: center 30%;
}

.section-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background-color: rgba(0, 0, 0, 0.2);
}
</style>