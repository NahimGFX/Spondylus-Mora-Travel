---
const { title, description, href } = Astro.props;
---

<div class="p-6 bg-white rounded-2xl shadow-lg w-full max-w-sm mx-8 my-8">
  <h2 class="text-4xl font-semibold text-[#176B87]">{title}</h2>
  <p class="text-gray-500 py-4">{description}</p>
  <a href={href}>
    <button class="bg-[#176B87] text-white px-4 py-2 rounded-md hover:bg-[#104d60] transition">
      Ver más
    </button>
  </a>
</div>
