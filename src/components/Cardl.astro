---
const { title, description } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-xl max-w-screen-md mx-auto my-10 overflow-hidden">
  <div class="bg-white p-6 border-b">
    <h2 class="text-5xl text-center font-semibold text-[#176B87]">{title}</h2>
  </div>

  <div class="bg-slate-100 p-8">
    <p class="text-gray-600 text-xl">{description}</p>
  </div>
</div>
